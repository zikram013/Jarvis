+def es_consulta_meteorologica(command):
+    """Evita confundir el tiempo meteorológico con la duración de un trayecto."""
+    travel_words = (
+        r"\b(?:tarda|tardar|trayecto|viaje|llegar|distancia|ruta|camino|"
