+        r"^\s*(?:dime (?:el )?)?tiempo\s*[?.!]*$",
+        r"\btiempo\s+(?:en|para)\b",
+        r"\b(?:que|qué|como|cómo)\s+(?:esta|está|hace|hara|hará)\s+(?:el )?tiempo\b",
