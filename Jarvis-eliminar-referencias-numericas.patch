+def remove_source_citations(text):
+    """Elimina referencias numéricas de fuentes sin alterar otros corchetes."""
+    return re.sub(
+        r"\s*\[(?:\d+\s*(?:,\s*\d+\s*)*)]",
+        "",
+        text,
+    ).strip()
+
+
